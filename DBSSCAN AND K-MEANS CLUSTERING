        "import matplotlib.pyplot as plt\n",
        "from sklearn.cluster import DBSCAN\n",
        "\n",
        "# Sample data\n",
        "X = [\n",
        "    [1, 2],\n",
        "    [2, 2],\n",
        "    [2, 3],\n",
        "    [3, 3],\n",
        "    [10, 10],\n",
        "    [10, 11],\n",
        "    [11, 10],\n",
        "    [11, 11],\n",
        "    [50, 50]\n",
        "]\n",
        "\n",
        "# Create DBSCAN model\n",
        "dbscan = DBSCAN(eps=2, min_samples=3)\n",
        "\n",
        "# Train the model\n",
        "dbscan.fit(X)\n",
        "\n",
        "# Get cluster labels\n",
        "labels = dbscan.labels_\n",
        "\n",
        "print(\"Cluster Labels:\", labels)\n",
        "\n",
        "# Plot the clusters\n",
        "plt.scatter(\n",
        "    [x[0] for x in X],\n",
        "    [x[1] for x in X],\n",
        "    c=labels\n",
        ")\n",
        "\n",
        "plt.title(\"DBSCAN Clustering\")\n",
        "plt.xlabel(\"X\")\n",
        "plt.ylabel(\"Y\")\n",
        "plt.show()"
